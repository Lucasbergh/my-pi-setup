{
  "name": "my-pi-setup",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "format": "prettier --write \"extensions/**/*.{ts,cjs}\" \"*.json\"",
    "format:check": "prettier --check \"extensions/**/*.{ts,cjs}\" \"*.json\"",
    "test": "node --test --experimental-strip-types extensions/*/*.test.ts && npm --prefix extensions/file-search test"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.101",
    "acorn": "^8.17.0",
    "effect": "4.0.0-beta.101",
    "firecrawl": "^4.30.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "@types/node": "^26.1.1",
    "prettier": "^3.9.5",
    "typebox": "^1.3.6",
    "typescript": "^7.0.2"
  }
}
